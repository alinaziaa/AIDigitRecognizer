<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0C1937">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join the AI Digit Recognition app"
            android:textColor="#B8C7DF"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Full Name"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8C7DF"
            android:backgroundTint="#00D4FF" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8C7DF"
            android:backgroundTint="#00D4FF" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Create Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8C7DF"
            android:backgroundTint="#00D4FF" />

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SIGN UP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:backgroundTint="#009BCD" />

        <Button
            android:id="@+id/btnBackLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="BACK TO LOGIN"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:backgroundTint="#263F65" />

    </LinearLayout>
</ScrollView>
